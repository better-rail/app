# Shared secret the Worker sends as `Authorization: Bearer <token>`. Required; the proxy refuses to start without it.
# Generate one with `openssl rand -hex 32` and set the same value as EGRESS_PROXY_TOKEN on the Worker.
EGRESS_PROXY_TOKEN=

# The only two upstreams the proxy will relay to. Only their hosts matter: any other target host gets a 403.
SIRI_URL=https://moran.mot.gov.il/Channels/HTTPChannel/SM/2.8
RAIL_URL=https://israelrail.azurefd.net

# moran.mot.gov.il serves an incomplete TLS chain. Preferred fix: the missing intermediate(+root) PEM, \n-escaped
# on one line. Quick unblock: SIRI_TLS_INSECURE=true skips verification for the SIRI host only.
SIRI_CA_PEM=
SIRI_TLS_INSECURE=false

# The rail API is geo-fenced to Israel: an HTTP proxy with an Israeli egress, e.g. http://user:pass@host:port.
# Leave empty when this host's own IP is in Israel. RAIL_TLS_INSECURE=true relaxes verification for the rail host only.
PROXY_URL=
RAIL_TLS_INSECURE=false

# Optional. Listening port and the per-request upstream deadline.
PORT=3000
EGRESS_TIMEOUT_MS=60000
