# gtfs (default) = MOT feed + SIRI; rail = proxy the Israel Railways API
RAIL_DATA_SOURCE=
RAIL_URL=
RAIL_API_KEY=
PROXY_URL=
RAIL_TLS_INSECURE=
# Service-status service (`bun run service-status`): Israel Railways service updates →
# announced disruptions (idle without OPENAI_API_KEY), and Israel Railways' timetable vs
# the GTFS schedule. Both need RAIL_URL + RAIL_API_KEY (+ PROXY_URL off-shore).
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=
ANNOUNCEMENTS_POLL_SECONDS=
TIMETABLE_CHECK_SECONDS=
TIMETABLE_WINDOW_MINUTES=
TIMETABLE_STALE_SECONDS=
