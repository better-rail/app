{
  "name": "@better-rail/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:assets && vite dev --port 3000",
    "build": "bun run build:assets && vite build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "compile": "tsc --noEmit -p . --pretty",
    "test": "bun test",
    "build:assets": "bun run build:images && bun run build:qr",
    "build:images": "bun run scripts/build-station-images.ts",
    "build:qr": "bun run scripts/build-qr-codes.ts"
  },
  "dependencies": {
    "@better-rail/stations": "workspace:*",
    "@resvg/resvg-wasm": "2.6.2",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-ssr-query": "^1.167.2",
    "@tanstack/react-start": "^1.168.49",
    "fuse.js": "^7.5.0",
    "jpeg-js": "0.4.4",
    "lucide-react": "^1.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "wrangler": "4.128.0"
  }
}
