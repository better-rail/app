# Applies to static assets only; Worker (SSR) responses get their headers in src/server.ts.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000

# The build's hashed output: a new build means a new URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Copied from public/ under stable names (icons, badges, press kit, photos): a day in the browser, refreshed quietly.
# Matching rules add their headers up; `!` drops the immutable one above before setting this one.
/assets/favicon/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/icons/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/images/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/press/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/team/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/documents/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/qr/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Station photos are re-rendered under the same names when a source photo changes.
/stations/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
