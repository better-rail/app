{
  "name": "@better-rail/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "index.js",
  "scripts": {
    "eas-build-on-success": "node ./scripts/sentry-eas-release.mjs",
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "compile": "tsc --noEmit -p . --pretty",
    "test": "bun test",
    "update:sourcemaps": "sentry-expo-upload-sourcemaps dist",
    "e2e": "bun run e2e:ios",
    "e2e:ios": "maestro test -e MAESTRO_APP_ID=il.co.better-rail .maestro/flows",
    "e2e:android": "maestro test -e MAESTRO_APP_ID=com.betterrail .maestro/flows",
    "adb": "adb reverse tcp:9090 tcp:9090 && adb reverse tcp:3000 tcp:3000 && adb reverse tcp:9001 tcp:9001 && adb reverse tcp:8081 tcp:8081"
  },
  "dependencies": {
    "@better-rail/stations": "workspace:*",
    "@expo/react-native-action-sheet": "4.1.1",
    "@expo/ui": "~58.0.19",
    "@legendapp/list": "3.6.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/push-notification-ios": "1.12.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@rnrepo/expo-config-plugin": "0.3.5",
    "@sentry/react-native": "8.30.0",
    "@ttsalpha/qrcode": "3.1.0",
    "axios": "1.20.0",
    "babel-plugin-module-resolver": "5.0.3",
    "burnt": "0.12.2",
    "date-fns": "2.30.0",
    "date-fns-tz": "2.0.0",
    "expo": "58.0.12",
    "expo-blur": "~58.0.3",
    "expo-build-properties": "~58.0.10",
    "expo-calendar": "~58.0.6",
    "expo-clipboard": "~58.0.3",
    "expo-dev-client": "~58.0.13",
    "expo-font": "~58.0.8",
    "expo-glass-effect": "~58.0.4",
    "expo-hinge": "~58.0.1",
    "expo-iap": "5.5.0",
    "expo-insights": "~58.0.11",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.4",
    "expo-network": "~58.0.3",
    "expo-notifications": "~58.1.4",
    "expo-observe": "~58.0.14",
    "expo-router": "~58.0.21",
    "expo-splash-screen": "~58.0.9",
    "expo-store-review": "~58.0.2",
    "expo-task-manager": "~58.0.12",
    "expo-updates": "~58.0.17",
    "i18n-js": "3.8.0",
    "lodash": "4.18.1",
    "posthog-react-native": "^4.66.2",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-bouncy-checkbox": "3.0.7",
    "react-native-date-picker": "5.0.12",
    "react-native-default-preference": "1.4.4",
    "react-native-device-info": "10.6.0",
    "react-native-edge-to-edge": "1.8.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-haptic-feedback": "2.3.3",
    "react-native-inappbrowser-reborn": "3.7.0",
    "react-native-linear-gradient": "2.5.6",
    "react-native-modal-datetime-picker": "18.0.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-prompt-android": "1.1.0",
    "react-native-push-notification": "8.1.1",
    "react-native-quick-actions-shortcuts": "1.0.2",
    "react-native-reanimated": "4.7.1",
    "react-native-restart-newarch": "^1.0.85",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-share": "11.0.3",
    "react-native-svg": "15.16.0",
    "react-native-touchable-scale": "2.2.0",
    "react-native-unistyles": "3.5.3",
    "react-native-video": "6.19.2",
    "react-native-watch-connectivity": "1.1.0",
    "react-native-worklets": "0.13.0",
    "react-query": "3.39.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/plugin-proposal-optional-catch-binding": "7.18.6",
    "@babel/preset-env": "7.25.3",
    "@babel/runtime": "7.25.0",
    "@bacons/apple-targets": "4.0.7",
    "@types/i18n-js": "3.0.3",
    "@types/lodash": "4.17.25",
    "@types/react": "~19.3.0",
    "@types/react-native-push-notification": "8.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "bufferutil": "4.0.2",
    "postinstall-prepare": "1.0.1",
    "react-native-console-time-polyfill": "1.2.3",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3",
    "utf-8-validate": "5.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native",
        "react-native-screens"
      ]
    },
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-localization"
        ]
      }
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@react-native-community/push-notification-ios",
          "@sentry/react-native",
          "react-native-push-notification",
          "react-native-default-preference",
          "react-native-prompt-android",
          "react-native-quick-actions-shortcuts"
        ]
      }
    }
  }
}
