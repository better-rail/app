                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.05"
                android:textColor="#111111"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:typeface="sans"
                android:fontFamily="@font/heebo_bold" />

            <TextView
                android:id="@+id/widget_upcoming_arrival_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.95"
                android:textColor="#757575"
                android:textSize="13.5sp"
                android:typeface="sans"
                android:fontFamily="@font/heebo_medium" />

            <TextView
                android:id="@+id/widget_upcoming_duration_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.60"
                android:textColor="#757575"
                android:textSize="13sp"
                android:typeface="sans"
                android:singleLine="true"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:textAlignment="viewStart"
                android:fontFamily="@font/heebo_medium" />

            <TextView
                android:id="@+id/widget_upcoming_platform_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.00"
                android:textColor="#757575"
                android:textSize="13.5sp"
                android:typeface="sans"
                android:gravity="start|center_vertical"
                android:textAlignment="viewStart"
                android:fontFamily="@font/heebo_medium" />

            <TextView
                android:id="@+id/widget_upcoming_train_num_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.65"
                android:textColor="#AEAEB2"
                android:textSize="13sp"
                android:typeface="sans"
                android:fontFamily="@font/heebo_medium"
                android:gravity="end" />
        </LinearLayout>

        <!-- Row 2 -->
        <FrameLayout
            android:id="@+id/widget_upcoming_divider_2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E5E5EA"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/widget_upcoming_row_2"
            android:layout_width="match_parent"
            android:layout_height="28dp"
