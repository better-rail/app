        <!-- Row 5 -->
        <FrameLayout
            android:id="@+id/widget_upcoming_divider_5"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E5E5EA"
            android:visibility="gone" />

        <LinearLayout
