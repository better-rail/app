<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container_compact_4x4"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Top Hero Section: Station Photo + Next Train Metrics -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="165dp">

        <!-- Station Background Image -->
        <ImageView
            android:id="@+id/widget_station_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/assets_railwaystation" />

        <!-- Dark Scrim Overlay -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#B3000000"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="10dp">

            <!-- Origin Station Name -->
            <TextView
                android:id="@+id/widget_station_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/station_3700"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:typeface="sans"
                android:fontFamily="@font/heebo_bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:shadowColor="#FF000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4" />

            <!-- Destination with Arrow -->
            <LinearLayout
                android:id="@+id/widget_destination_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <ImageView
                    android:id="@+id/widget_arrow_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_arrow_circle"
                    android:layout_marginEnd="5dp"
                    android:contentDescription="Arrow to destination" />

                <TextView
                    android:id="@+id/widget_destination"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/arrival"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp"
                    android:typeface="sans"
                    android:fontFamily="@font/heebo_medium"
                    android:shadowColor="#FF000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4" />
            </LinearLayout>

            <!-- Spacer -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- NEXT TRAIN Badge -->
            <TextView
                android:id="@+id/widget_train_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/next_train"
                android:textColor="#FA827E"
                android:textSize="11sp"
                android:textStyle="bold"
                android:typeface="sans"
                android:fontFamily="@font/heebo_bold"
                android:shadowColor="#FF000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:layout_marginBottom="2dp" />

            <!-- Metrics Row (Departure, Arrival, Platform, Train No.) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="true"
                android:gravity="bottom">

                <!-- Large Departure Time -->
                <TextView
                    android:id="@+id/widget_next_train_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="--:--"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:typeface="sans"
                    android:fontFamily="@font/heebo_bold"
                    android:shadowColor="#FF000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4" />

                <!-- Arrival Column -->
                <LinearLayout
                    android:id="@+id/widget_arrival_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:baselineAlignedChildIndex="1"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:id="@+id/widget_arrival_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/arrival_caps"
                        android:textColor="#B3FFFFFF"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:typeface="sans"
                        android:fontFamily="@font/heebo_bold" />

                    <TextView
                        android:id="@+id/widget_arrival_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="--:--"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:typeface="sans"
                        android:fontFamily="@font/heebo_bold"
                        android:shadowColor="#FF000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="3" />
                </LinearLayout>

                <!-- Platform Column -->
                <LinearLayout
                    android:id="@+id/widget_platform_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:baselineAlignedChildIndex="1">

                    <TextView
                        android:id="@+id/widget_platform_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/platform_caps"
                        android:textColor="#B3FFFFFF"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:typeface="sans"
                        android:fontFamily="@font/heebo_bold" />

                    <TextView
                        android:id="@+id/widget_platform_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="--"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:typeface="sans"
                        android:fontFamily="@font/heebo_bold"
                        android:shadowColor="#FF000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="3" />
                </LinearLayout>

                <!-- Train No. Column -->
                <LinearLayout
                    android:id="@+id/widget_train_num_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:baselineAlignedChildIndex="1">

                    <TextView
                        android:id="@+id/widget_train_num_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/train_no_caps"
                        android:textColor="#B3FFFFFF"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:typeface="sans"
                        android:fontFamily="@font/heebo_bold" />

                    <TextView
                        android:id="@+id/widget_train_num_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="---"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:typeface="sans"
                        android:fontFamily="@font/heebo_bold"
                        android:shadowColor="#FF000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="3" />
                </LinearLayout>

            </LinearLayout>

            <!-- Fallback text for configuration / error states -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">
                <TextView
                    android:id="@+id/widget_platform"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/widget_dot_separator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="‧"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/widget_train_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Schedule Table Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <!-- Table Column Headers -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/widget_header_depart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.05"
                android:text="@string/depart_caps"
                android:textColor="#AEAEB2"
                android:textSize="10sp"
                android:maxLines="1"
                android:singleLine="true"
                android:typeface="sans"
                android:fontFamily="@font/heebo_medium" />

            <TextView
                android:id="@+id/widget_header_arrive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.95"
                android:text="@string/arrive_caps"
                android:textColor="#AEAEB2"
                android:textSize="10sp"
                android:maxLines="1"
                android:singleLine="true"
                android:typeface="sans"
                android:fontFamily="@font/heebo_medium" />

            <TextView
                android:id="@+id/widget_header_duration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.60"
                android:text="@string/duration_caps"
                android:textColor="#AEAEB2"
                android:textSize="10sp"
                android:maxLines="1"
                android:singleLine="true"
                android:typeface="sans"
                android:fontFamily="@font/heebo_medium" />

            <TextView
                android:id="@+id/widget_header_platform"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.00"
                android:text="@string/platform_caps"
                android:textColor="#AEAEB2"
                android:textSize="9.5sp"
                android:maxLines="1"
                android:singleLine="true"
                android:typeface="sans"
                android:fontFamily="@font/heebo_medium" />

            <TextView
                android:id="@+id/widget_header_train"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.65"
                android:text="@string/train_caps"
                android:textColor="#AEAEB2"
                android:textSize="10sp"
                android:maxLines="1"
                android:singleLine="true"
                android:typeface="sans"
                android:fontFamily="@font/heebo_medium"
                android:gravity="end" />
        </LinearLayout>

        <!-- Empty / Error state placeholder inside table -->
        <TextView
            android:id="@+id/widget_upcoming_label"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/upcoming"
            android:textColor="#757575"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Row 1 -->
