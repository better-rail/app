EXPO_PUBLIC_POSTHOG_API_KEY=dev
EXPO_PUBLIC_ANALYTICS_IN_DEV=false

# Local development overrides. Copy to .env.local (gitignored) and restart Metro with `-c`.
# Point the app at `bun run api:dev` (wrangler dev in apps/api; 127.0.0.1 on iOS, 10.0.2.2 on Android):
# EXPO_PUBLIC_API_ENV=local
# Or at a Workers Preview of the API by its branch name (https://api-<branch>.better-rail.co.il):
# EXPO_PUBLIC_API_ENV=my-branch
# Or at any server outright, e.g. a physical device reaching your machine over the LAN:
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8787/api/v1
# Show a made-up service-status snapshot with every kind of disruption (dev builds only):
# EXPO_PUBLIC_SIMULATE_SERVICE_STATUS=true
