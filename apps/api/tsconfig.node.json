{
  // The Bun side of the package: the ingest container entry and the operator CLIs.
  // (The Worker itself is checked by tsconfig.json; the tests run under `bun test`.)
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2022"],
    "types": ["bun", "@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true
  },
  "include": ["ingest", "scripts"]
}
