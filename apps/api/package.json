{
  "name": "@better-rail/api",
  "version": "2.0.0",
  "description": "Better Rail API — Cloudflare Worker (timetable, live rides, fares, SIRI realtime)",
  "license": "AGPL-3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "compile": "tsc --noEmit -p . --pretty && tsc --noEmit -p tsconfig.node.json --pretty",
    "test": "bun test src && vitest run",
    "test:unit": "bun test src",
    "test:workers": "vitest run",
    "ingest": "bun ./ingest/main.ts",
    "rail:pull": "bun ./scripts/rail-pull.ts",
    "build:mapping": "bun ./scripts/build-station-mapping.ts",
    "verify:mapping": "bun ./scripts/verify-mapping.ts",
    "download": "bun ./scripts/download-feed.ts",
    "d1:schema": "wrangler d1 execute better-rail --remote --file=./src/db/schema.sql",
    "d1:schema:local": "wrangler d1 execute better-rail --local --file=./src/db/schema.sql"
  },
  "dependencies": {
    "@sentry/cloudflare": "11.8.0",
    "csv-parse": "^7.0.2",
    "date-fns": "^2.29.3",
    "dayjs": "^1.11.7",
    "elysia": "1.4.30",
    "lodash": "^4.17.21",
    "unzipper": "^0.12.3",
    "zod": "^3.21.4",
    "@cloudflare/containers": "0.3.7",
    "@sinclair/typebox": "0.34.52"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261019.1",
    "@types/bun": "^1.3.0",
    "@types/lodash": "^4.14.191",
    "@types/unzipper": "^0.10.10",
    "typescript": "^5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.128.0"
  }
}
