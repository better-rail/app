{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 130,
  "semi": false,
  "singleQuote": false,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "apps/mobile/ios-native",
    "apps/mobile/android-native",
    "apps/mobile/ios",
    "apps/mobile/android",
    "apps/website",
    ".vscode",
    "**/package.json",
    "**/*.xcassets",
    "apps/mobile/assets/icons/AppIcon.icon",
    "apps/mobile/google-services.development.json",
    "**/dist",
    ".claude"
  ]
}
