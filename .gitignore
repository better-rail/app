# Android
.gradle
local.properties
*.iml
*.hprof
.cxx/
.kotlin/
*.aab

# CNG (Continuous Native Generation): native projects are generated by `expo prebuild`.
# Source of truth is app.config.ts + ./plugins + ./targets. Do not commit these.
/apps/mobile/ios
/apps/mobile/android

# Production Firebase config (injected by CI / EAS secrets). The *.development.* variants ARE committed.
/apps/mobile/GoogleService-Info.plist
/apps/mobile/google-services.json

# Expo
.expo/
web-build/
*.jsbundle
.metro-health-check*
/apps/mobile/bin/Exponent.app

# CocoaPods / fastlane
**/Pods/
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output
*.orig.*

# apple-targets generated entitlements (regenerated each prebuild)
/apps/mobile/targets/**/generated.entitlements
# apple-targets regenerates the watch app icon from targets/watch/icon.png each prebuild
/apps/mobile/targets/watch/Assets.xcassets/AppIcon.appiconset/

# Metro release bundler artifacts (regenerated at build time) — never commit under source.
# EXCEPTION: the station/railway widget drawables are referenced by native code
# (StationsData.kt R.drawable.assets_stationimages_*, widget_compact_*.xml
# @drawable/assets_railwaystation) and are NOT produced by a CNG/EAS debug build,
# so they must be committed as real native drawables.
/apps/mobile/android-native/res/drawable-*/assets_*
!/apps/mobile/android-native/res/drawable-*/assets_stationimages_*
!/apps/mobile/android-native/res/drawable-*/assets_railwaystation.*
/apps/mobile/android-native/res/drawable-*/node_modules_*
/apps/mobile/android-native/res/raw/assets_*

# ---------------------------------------------------------------------------
# apps/server
# ---------------------------------------------------------------------------
/apps/server/db
