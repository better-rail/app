@@ -69,6 +69,17 @@ - (void)viewDidLayoutSubviews
 {
   [super viewDidLayoutSubviews];
 
+  // The column's view is a React component view, so React also sets its frame, from the last size this controller
+  // reported. A size UIKit gave the column while it was off screen (a collapsed split view's secondary column keeps
+  // the bounds of the display it was last expanded on) then comes back from React once the column is pushed into
+  // the primary's navigation controller, and the stale size is reported again. The container UIKit put the column
+  // in is the authority on its size.
+  UIView *container = self.view.superview;
+  if (container != nil && [self isInSplitHostSubtree] &&
+      !CGSizeEqualToSize(self.view.bounds.size, container.bounds.size)) {
+    self.view.frame = container.bounds;
+  }
+
   [self updateShadowTreeState];
 }
 
