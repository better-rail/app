# .easignore — used by EAS Build INSTEAD of .gitignore when present.
# Mirrors .gitignore so the build archive matches git, EXCEPT it re-includes
# the production google-services.json (gitignored) so LOCAL `eas build --local`
# can find it during prebuild. Keep in sync with .gitignore.

.DS_Store
node_modules/
npm-debug.*
yarn-error.log
*.log
.env
.env.local
.env.development
.env.production
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.der
*.keystore
!debug.keystore
*.pem
.idea
.cursor/mcp.json
.claude/
**/dist/
**/build/
*.tsbuildinfo

# Not needed for a mobile build
/apps/server/
/apps/website/
/.github/
/.conductor/
/.vscode/

# Xcode / Android
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata
*.xccheckout
*.moved-aside
DerivedData
*.hmap
*.ipa
*.dSYM.zip
*.xcuserstate
*.xcode.env.local
.gradle
local.properties
*.iml
*.hprof
.cxx/
.kotlin/
*.aab

# CNG: native projects are generated by `expo prebuild`.
/apps/mobile/ios
/apps/mobile/android

# Production Firebase config (injected by CI / EAS secrets).
/apps/mobile/GoogleService-Info.plist
/apps/mobile/google-services.json
# Re-include google-services.json for local EAS builds (see header note).
!/apps/mobile/google-services.json

.expo/
web-build/
*.jsbundle
.metro-health-check*
/apps/mobile/bin/Exponent.app
**/Pods/
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output
*.orig.*
/apps/mobile/targets/**/generated.entitlements
/apps/mobile/targets/watch/Assets.xcassets/AppIcon.appiconset/
/apps/mobile/android-native/res/drawable-*/assets_*
!/apps/mobile/android-native/res/drawable-*/assets_stationimages_*
!/apps/mobile/android-native/res/drawable-*/assets_railwaystation.*
/apps/mobile/android-native/res/drawable-*/node_modules_*
/apps/mobile/android-native/res/raw/assets_*
